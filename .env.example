# Application
NODE_ENV=development
APP_NAME=node-express-boilerplate
APP_PORT=8080
LOG_LEVEL=info

# Graceful shutdown: how long to wait for in-flight requests before force-exit (ms)
SHUTDOWN_TIMEOUT_MS=10000

# API docs (/docs + /openapi.json). Defaults to enabled outside production.
# DOCS_ENABLED=true

# Database (MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=node_express_boilerplate
DATABASE_USERNAME=root
DATABASE_PASSWORD=root
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Set by CI/CD or Docker build; surfaced in /v1/health
# GIT_COMMIT=
