# Application
NODE_ENV=development
APP_NAME=node-express-boilerplate
APP_PORT=8080
LOG_LEVEL=info

# Graceful shutdown: how long to wait for in-flight requests before force-exit (ms)
SHUTDOWN_TIMEOUT_MS=10000
# After a stop signal, readiness answers 503 for this long before the listener closes
SHUTDOWN_DRAIN_DELAY_MS=2000

# API docs (/docs + /openapi.json). Defaults to enabled outside production.
# DOCS_ENABLED=true

# Database (MySQL)
DATABASE_HOST=localhost
DATABASE_PORT=3307
DATABASE_NAME=node_express_boilerplate
DATABASE_USERNAME=root
DATABASE_PASSWORD=root
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis — used for caching (identity principals). Optional: when unset,
# caching falls back to in-memory (fine for a single dev process).
# REDIS_URL=redis://localhost:6380
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=300

# Readiness probe: each dependency check is bounded to this
HEALTH_CHECK_TIMEOUT_MS=1500

# CORS — comma-separated allowed origins. REQUIRED in staging and production;
# when empty in development / test every origin is allowed.
# CORS_ORIGINS=https://global.shopup.com.bd,http://localhost:5173

# File storage — Google Cloud Storage. Credentials come from Application
# Default Credentials (GOOGLE_APPLICATION_CREDENTIALS=/path/key.json locally,
# the attached service account on GCP). GCS_BUCKET is REQUIRED in staging and
# production; when unset in development / test, files go to STORAGE_LOCAL_DIR.
# GCS_BUCKET=shopup-global-documents
# GCS_PROJECT_ID=
STORAGE_LOCAL_DIR=.storage
STORAGE_SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_BYTES=10485760

# Auth — backed by the central ShopUp identity service.
# Base URL of the identity service (see shopup-lite's authApiBaseUrlByEnv for
# per-environment URLs, e.g. https://api.shopup.com.bd/auth in production).
# In production, IDENTITY_SERVICE_URL and/or AUTH_JWT_PUBLIC_KEY is required.
# IDENTITY_SERVICE_URL=
IDENTITY_SERVICE_TIMEOUT_MS=5000
# How long resolved principals are cached per token (in-memory)
AUTH_CACHE_TTL_SECONDS=60
# How long an invalid or expired token is remembered as invalid (negative cache)
AUTH_NEGATIVE_CACHE_TTL_SECONDS=15
# Base64-encoded RSA public key of the identity service, enabling local
# verification of `Authorization: jwt <token>` (RS256, subject "auth")
# AUTH_JWT_PUBLIC_KEY=
COOKIE_NAME=token
# REQUIRED in staging and production (any long random string; verifies the signed auth cookie)
COOKIE_SECRET=dev-cookie-secret-change-me
# Dev only — injects a SYSADMIN principal when unauthenticated (rejected in
# staging and production). JIMMY_IDENTITY is the identity user id to act as; change it to
# test two-person rules (e.g. onboard a bank as 1, approve as 2).
# JIMMY_AUTH=true
# JIMMY_IDENTITY=1

# Set by CI/CD or Docker build; surfaced in /v1/health
# GIT_COMMIT=
