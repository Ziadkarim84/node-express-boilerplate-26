{
  "name": "node-express-boilerplate",
  "version": "1.0.0",
  "description": "Production-ready Node.js + Express 5 + TypeScript boilerplate",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "git rev-parse HEAD > dist/commit.txt 2>/dev/null || true",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mg:new": "node scripts/new-migration.js",
    "mg:newscaff": "node scripts/new-model.js",
    "mg:info": "synor info --config=.synorrc.cjs --outOfOrder",
    "mg:latest": "./scripts/migrate-to-latest-version.sh --outOfOrder",
    "prepare": "husky"
  },
  "keywords": [
    "node",
    "express",
    "typescript",
    "boilerplate"
  ],
  "author": "ShopUp Engineering",
  "license": "MIT",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@scalar/express-api-reference": "^0.10.16",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@synor/cli": "^0.9.2",
    "@synor/core": "^0.9.3",
    "@synor/database-mysql": "0.5.0",
    "@synor/source-file": "^0.6.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prompts": "^2.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,js,cjs}": "eslint --fix",
    "*.{ts,js,cjs,json,md,yml,yaml}": "prettier --write"
  }
}
